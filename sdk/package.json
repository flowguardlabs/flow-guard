{
  "name": "@flowguardlabs/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for FlowGuard — contract-backed treasuries, streams, payments, and subscriptions on Bitcoin Cash",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:examples": "tsc --noEmit -p tsconfig.examples.json",
    "test": "node test/live-smoke.mjs",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "//publishConfig": "Scoped packages default to restricted, which fails on a free npm account. This makes the first publish public without needing --access on the command line.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/winsznx/flow-guard.git",
    "directory": "sdk"
  },
  "homepage": "https://docs.flowguard.cash/sdk/overview",
  "bugs": {
    "url": "https://github.com/winsznx/flow-guard/issues"
  },
  "keywords": [
    "bitcoin-cash",
    "bch",
    "cashscript",
    "payments",
    "subscriptions",
    "flowguard"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.0.0",
    "express": "^4.22.1",
    "typescript": "^5.0.0"
  }
}
