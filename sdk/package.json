{
  "name": "@flowguard/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for FlowGuard — contract-backed treasuries, streams, payments, and subscriptions on Bitcoin Cash",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/**/*.test.js"
  },
  "keywords": [
    "bitcoin-cash",
    "bch",
    "cashscript",
    "payments",
    "subscriptions",
    "flowguard"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^20.0.0",
    "express": "^4.22.1",
    "typescript": "^5.0.0"
  }
}
