# FlowGuard Backend Environment Variables
# Copy this file to .env for local development

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (Supabase Postgres)
# Pooler URL (port 6543) for runtime app queries
# Any PostgreSQL works. Supabase is what flowguard.cash happens to run on, not a
# requirement — there is no Supabase client or SDK anywhere in this codebase, just
# `pg` and a connection string. Self-hosted, RDS, Neon and a box on your LAN are all
# fine.
#
# Self-hosted:
# DATABASE_URL="postgresql://user:password@localhost:5432/flowguard"
#
# Supabase (pooled for the app, direct for DDL):
# DATABASE_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.<project>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# DIRECT_URL is only needed when DATABASE_URL points at a pooler that cannot run DDL.
# Against a plain Postgres, leave it unset.
DATABASE_URL=
DIRECT_URL=

# Postgres TLS. The audit (M-04) made cert validation the default, so pick one:
#
#   PG_SSL_DISABLED=true    no TLS at all. Correct for a Postgres on localhost or a
#                           trusted LAN, wrong across the public internet.
#   PG_SSL_CA_PATH / _PEM   pin your own CA. The right answer when you run the
#                           database yourself with its own certificate.
#   PG_SSL_INSECURE=true    keep TLS, skip CA verification. An escape hatch for
#                           managed providers whose CA is not in Node's default
#                           trust store — Supabase's pooler is one, which reads as
#                           "self-signed-in-chain". Not needed otherwise.
#
# PG_SSL_DISABLED=true
# PG_SSL_INSECURE=true
# PG_SSL_CA_PEM=
# PG_SSL_CA_PATH=

# Encryption key for airdrop/reward/bounty/grant authority private keys at rest.
# Required for any airdrop/reward/bounty/grant operation (create or claim).
# Generate with: openssl rand -hex 32
# WARNING: If this key is lost or rotated, all encrypted authority keys in the
# DB become unrecoverable. Store offline alongside your DB backup.
AIRDROP_CLAIM_KEY_ENCRYPTION_KEY=

# SIWX (Sign-In With BCH) bearer-token signing secret.
# HMAC-SHA256 key used to sign/verify the 30-minute bearer tokens issued by
# POST /api/auth/verify. MUST be set in production. Without it the process
# generates a random per-startup key, so tokens issued on one replica fail
# verification on another (and all tokens are invalidated on every restart).
# Generate with: openssl rand -hex 32
SIWX_BEARER_SECRET=

# Optional SIWX CAIP-122 message context. These bind the sign-in message to
# your deployment so a signature for one domain cannot be replayed against
# another. Defaults are baked in for flowguard.cash; override per environment.
# SIWX_DOMAIN=flowguard.cash
# SIWX_URI=https://www.flowguard.cash
# SIWX_CHAIN_ID=bch:bitcoincash  # or bch:bchtest for chipnet

# Optional: fee sponsor wallet (covers tx fees for users on claim flows).
# Hex private key (64 chars). Leave empty to disable sponsorship.
# BACKEND_FEE_PAYER_KEY_HEX=

# CORS allowlist (comma-separated). Exact origins, or https://*.host wildcards.
# Defaults to the flowguard.cash origins when unset. Never use a bare wildcard —
# reflection plus credentials is a cross-site takeover vector.
# CORS_ALLOWED_ORIGINS=https://flowguard.cash,https://app.flowguard.cash

# Allow native WebView origins (capacitor://localhost, ionic://localhost,
# http(s)://localhost) so a wallet-hosted FlowGuard add-on can call the API.
# Exact-match only against a fixed four-entry set — no wildcards, no port ranges.
# Leave false until an add-on actually ships.
# CORS_ALLOW_NATIVE_APP_ORIGINS=false

# Shared secret with the Cloudflare Worker that proxies /api/* (frontend/worker.js).
# The Worker forwards the real visitor address as x-flowguard-client-ip alongside
# x-flowguard-edge-secret; the backend honours that address only when the secret
# matches. api.flowguard.cash is reachable directly, so an unauthenticated IP claim
# would let anyone choose their own rate-limit bucket. Unset = headers ignored and
# rate limiting falls back to the peer address (which, behind the Worker, is a
# rotating Cloudflare egress IP — i.e. effectively unlimited).
# EDGE_PROXY_SECRET=

# Status URL for the indexer container, reachable over the compose network only.
# Without it the public status page reports the indexer as `unknown` whether it is
# healthy or dead. The indexer's status server needs STATUS_PORT set explicitly —
# it otherwise falls back to PORT, which this file sets to 3001.
# INDEXER_STATUS_URL=http://indexer:8080/status

# Bitcoin Cash Network Configuration
# Options: mainnet, chipnet (testnet)
BCH_NETWORK=chipnet

# Optional: Chaingraph URL for blockchain queries
# CHAINGRAPH_URL=http://localhost:3000

# Optional: admin-only data export endpoint protection (any random string)
# ADMIN_EXPORT_TOKEN=

# Funding output tuning (satoshis)
# Global default for token-bearing covenant outputs (module-specific vars override this)
TOKEN_CONTRACT_SATOSHIS=20000
# Dust used for token change outputs
TOKEN_OUTPUT_DUST_SATOSHIS=1000
# Optional module-specific overrides
# PAYMENT_TOKEN_CONTRACT_SATOSHIS=20000
# STREAM_TOKEN_CONTRACT_SATOSHIS=20000
# BUDGET_TOKEN_CONTRACT_SATOSHIS=20000
# AIRDROP_TOKEN_CONTRACT_SATOSHIS=20000
