FROM --platform=linux/amd64 node:22-alpine

WORKDIR /app

COPY backend/package.json backend/pnpm-lock.yaml ./

RUN npm install -g pnpm@10

# --ignore-scripts: pnpm 10 errors hard on unapproved native module build
# scripts (better-sqlite3 is a devDep only used by one-time migration scripts).
# The runtime uses pg, not better-sqlite3 — we don't need its native binding
# built in this image.
RUN pnpm install --prod --ignore-scripts

COPY backend/src ./src
COPY backend/tsconfig.json ./tsconfig.json
# `pnpm build` is tsc plus scripts/copy-runtime-assets.mjs, which puts
# postgres-schema.sql into dist. Without this the build fails on a missing script.
COPY backend/scripts ./scripts
COPY contracts/artifacts ./contracts/artifacts

# Dev deps for TS build only; same ignore-scripts treatment then prune.
RUN pnpm install --ignore-scripts
RUN pnpm build
RUN pnpm prune --prod

# TypeScript only emits .ts -> .js; copy non-TS runtime assets
RUN mkdir -p dist/database && cp src/database/postgres-schema.sql dist/database/

EXPOSE 3001

# Follows PORT rather than hardcoding 3001. The same image serves both networks and
# the chipnet stack listens on 3002, so a fixed port probed the wrong one and marked
# a working container unhealthy — which would also stall any `depends_on:
# condition: service_healthy` waiting on it.
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD node -e "const p=process.env.PORT||3001;require('http').get('http://localhost:'+p+'/health',(r)=>{process.exit(r.statusCode===200?0:1)}).on('error',()=>process.exit(1))"

CMD ["node", "dist/index.js"]
